{
  "name": "connected-in-climate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "node --test server/matching.test.js",
    "test:api": "node --env-file=.env --test server/match-api.test.js server/action-feedback-api.test.js server/admin-api.test.js",
    "test:all": "node --test server/matching.test.js && node --env-file=.env --test server/match-api.test.js server/action-feedback-api.test.js server/admin-api.test.js",
    "import": "node --env-file=.env scripts/import.js",
    "import:dry": "node --env-file=.env scripts/import.js --dry-run"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
